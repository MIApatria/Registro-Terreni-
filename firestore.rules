rules_version = '2';
// Regole per Cloud Firestore: tutti gli utenti autenticati (i 3 proprietari)
// leggono e scrivono gli stessi dati. Accesso paritario, nessun ruolo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
